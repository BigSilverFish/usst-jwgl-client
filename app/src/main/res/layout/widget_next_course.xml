<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llNextWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: 状态徽标与刷新按钮 -->
    <LinearLayout
        android:id="@+id/llNextHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNextBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="下一节课 · 25分钟后"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 课程门户：快速签到入口 -->
        <TextView
            android:id="@+id/btnNextQuickSign"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_widget_sign_pill"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="⚡ 签到"
            android:textColor="@color/on_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnNextRefresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="2dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/text_secondary"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <View
        android:id="@+id/viewNextDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:background="@color/border" />

    <!-- 焦点课程信息 -->
    <LinearLayout
        android:id="@+id/llNextCourseContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNextCourseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="高等数学 (下)"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 教室地点 -->
        <LinearLayout
            android:id="@+id/llNextRoomRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivNextRoomIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_location"
                android:tint="@color/primary"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/tvNextRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="一教 302"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 时段与节次 -->
        <TextView
            android:id="@+id/tvNextTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="1-2节 08:00-09:35"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- 授课教师 -->
        <TextView
            android:id="@+id/tvNextTeacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="主讲: 张教授"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />

        <!-- 课程门户待交作业提示 -->
        <LinearLayout
            android:id="@+id/llNextTodoRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_widget_urgent_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvNextTodo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="📝 待办: 实验四 · 还有 5小时截止"
                android:textColor="#B91C1C"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- 空状态：无课或今日已结课 -->
    <LinearLayout
        android:id="@+id/llNextEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivNextEmptyIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_empty_courses"
            android:tint="@color/text_tertiary"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/tvNextEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="今日课程已全部结束"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNextEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="好好休息，享受大学时光吧~"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

        <!-- 空状态下的临近待办提示 -->
        <TextView
            android:id="@+id/tvNextEmptyTodo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_widget_urgent_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="⚠️ 提示: 近期有 1 项待交作业截止"
            android:textColor="#B91C1C"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
