<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. CameraX 实时相机预览视图 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. 半透明取景框与对准区域提示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- 扫码取景框 -->
        <FrameLayout
            android:id="@+id/scanFinderBox"
            android:layout_width="280dp"
            android:layout_height="280dp">

            <!-- 取景框外框描边 (白/亮色圆角) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#26FFFFFF" />

            <!-- 四角对准角标 -->
            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="top|start"
                android:background="#4ADE80" />
            <View
                android:layout_width="4dp"
                android:layout_height="32dp"
                android:layout_gravity="top|start"
                android:background="#4ADE80" />

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="top|end"
                android:background="#4ADE80" />
            <View
                android:layout_width="4dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:background="#4ADE80" />

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|start"
                android:background="#4ADE80" />
            <View
                android:layout_width="4dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|start"
                android:background="#4ADE80" />

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|end"
                android:background="#4ADE80" />
            <View
                android:layout_width="4dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:background="#4ADE80" />

        </FrameLayout>

        <!-- 提示文字 -->
        <TextView
            android:id="@+id/tvScanTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="#80000000"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="将教师端大屏幕 / 投影仪二维码置入框内"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Google ML Kit 深度视觉引擎 · 强抗反光与远距离识别"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- 3. 顶部沉浸式导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="#66000000"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="课堂扫码签到"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnTorch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="#66000000"
            android:src="@drawable/ic_tune"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- 4. 底部数字变焦控制面板 (阶梯教室/远距离投影仪大屏特化) -->
    <LinearLayout
        android:id="@+id/layoutZoomControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_badge_rounded"
        android:backgroundTint="#B3000000"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- 变焦倍数快捷切换行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvZoomValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="变焦 1.0x"
                android:textColor="#4ADE80"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoom1x"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#33FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoom2x"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#33FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="2.0x"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoom3x"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#33FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="3.0x"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoom5x"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#33FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="5.0x"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 平滑变焦滑杆 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1x"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/sbZoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="#4ADE80"
                android:thumbTint="#4ADE80" />

            <TextView
                android:id="@+id/tvMaxZoomLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5x"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
