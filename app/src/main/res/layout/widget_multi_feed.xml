<?xml version="1.0" encoding="utf-8"?>
<!-- The widget host inflates RemoteViews with framework ImageViews; keep android:tint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Tab Pills + Quick Sign + Refresh -->
    <LinearLayout
        android:id="@+id/llWidgetTopTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabWidgetSchedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_widget_sign_pill"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:text="课表"
            android:textColor="@color/on_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabWidgetTodos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_widget_badge"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:text="待办"
            android:textColor="@color/badge_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabWidgetNotices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_badge"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:text="通知"
            android:textColor="@color/badge_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnWidgetQuickSign"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_widget_sign_pill"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="签到"
            android:textColor="@color/on_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnWidgetRefresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="2dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/text_secondary"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <!-- Sub-header: Date & Day Navigation (Schedule) or Feed Window Hint (Todo/Notice) -->
    <LinearLayout
        android:id="@+id/llWidgetSubHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWidgetHeaderDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="第 6 周 · 周五 (10/16)"
            android:textColor="@color/text_primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llWidgetDateNav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnWidgetPrevDay"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="3dp"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/text_secondary"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/btnWidgetResetToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/bg_widget_badge"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="今"
                android:textColor="@color/badge_text"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnWidgetNextDay"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="3dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/text_secondary"
                tools:ignore="UseAppTint" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWidgetStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_widget_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1.5dp"
            android:text="共 4 门课"
            android:textColor="@color/badge_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/border" />

    <!-- ListView & Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvWidgetCourses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/llWidgetEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivWidgetEmptyIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_empty_courses"
                android:tint="@color/text_tertiary"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/tvWidgetEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="暂无待办"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="近 7 天暂无待办或通知"
                android:textColor="@color/text_tertiary"
                android:textSize="10.5sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
