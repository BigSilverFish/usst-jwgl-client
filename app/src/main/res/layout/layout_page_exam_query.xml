<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutExamQuery"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:visibility="gone">

    <!-- Exam List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExamQueryList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingBottom="24dp" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyExamQuery"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="44sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="暂无排定的考试"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="当前学期教务系统暂未发布考试日程\n或该学期所有考试已全部顺利结束"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptySyncExamQuery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primary"
            android:text="重新从教务系统同步"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Top Header Bar with Frosted Glass -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurViewExamQuery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top">

        <LinearLayout
            android:id="@+id/llExamQueryHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_top_bar"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/headerExamQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/btnOpenDrawerExamQuery"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="打开侧栏"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvExamQueryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="考试日程与考场"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExamQuerySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="期末、期中与缓补考日程查询 · 考场与座号"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshExamQuery"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="刷新考试日程"
                    app:icon="@drawable/ic_refresh"
                    app:iconSize="20dp"
                    app:iconTint="@color/primary" />
            </LinearLayout>

            <!-- Semester & Summary Banner (Directly on Frosted Header) -->
            <LinearLayout
                android:id="@+id/cardExamQueryFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnSwitchExamSemester"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp">

                        <TextView
                            android:id="@+id/tvExamSemesterBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026-2027 第一学期"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvExamUpcomingSummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="正在同步考试日程..."
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBarExamQuery"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Boundary Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="@color/border" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</FrameLayout>
