<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/badge_bg"
            android:padding="5dp"
            android:src="@drawable/ic_bolt"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动刷学习进度"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="一网畅学全自动多视频并发看课"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Course & Progress Summary Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_badge_rounded"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvTargetCourseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="课程：项目管理与过程改进"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAutoProgressStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="待刷取：59 个视频 · 15 份资料 · 1 个测验"
            android:textColor="@color/primary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Concurrency Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="同时看课视频数（并发量）"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgConcurrency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbConcurrent3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3 个视频"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rbConcurrent5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="5 个 (推荐)"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rbConcurrent8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="8 个 (极速)"
            android:textSize="12sp" />

    </RadioGroup>

    <!-- Checkboxes -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="刷课范围与选项"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/cbAutoVideos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:text="视频网课（分段并发看课，自动刷满 100%）"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/cbAutoMaterials"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="课件与资料（PPT、PDF、文档等自动标记已读）"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/cbAutoExams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="课程测验与测试（自动访问测验、同步题纲与测试记录）"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/cbAutoSkipDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="智能跳过已完成项（无需重复刷取）"
        android:textSize="12sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAutoProgress"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartAutoProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/primary"
            android:text="⚡ 开始自动刷课"
            android:textColor="@android:color/white"
            app:cornerRadius="8dp" />

    </LinearLayout>

</LinearLayout>
