<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutCourseSelection"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:visibility="gone">

    <!-- 1. Content Layer: ViewPager2 for smooth horizontal swiping between categories -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpSelectionCategories"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fullscreen Loading Spinner (shown during initial entry context fetch) -->
    <ProgressBar
        android:id="@+id/pbSelectionLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 2. Floating Frosted Glass Header Layer (Title Bar + Category Tabs + Search Card) -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurViewCourseSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top">

        <LinearLayout
            android:id="@+id/llCourseSelectionHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_top_bar"
            android:orientation="vertical">

            <!-- Top Header Bar -->
            <LinearLayout
                android:id="@+id/headerCourseSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/btnOpenDrawerSelection"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="打开侧栏"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSelectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="自主选课"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSelectionStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/badge_bg"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1.5dp"
                            android:text="选课开放中"
                            android:textColor="@color/primary"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Subtitle (2 Lines: Academic Year & Semester + Election Round & Time Range) -->
                    <TextView
                        android:id="@+id/tvSelectionSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:text="加载中…"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Selection Confirmation Settings Button -->
                <ImageView
                    android:id="@+id/btnSelectionSettings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="选课确认设置"
                    android:focusable="true"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_tune"
                    app:tint="@color/text_secondary" />

                <!-- Fold / Expand Search Bar Button -->
                <ImageView
                    android:id="@+id/btnToggleSearchFold"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="折叠搜索栏"
                    android:focusable="true"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_search"
                    app:tint="@color/primary" />

                <!-- Refresh Button -->
                <ImageView
                    android:id="@+id/btnRefreshSelection"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="刷新选课"
                    android:focusable="true"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/primary" />
            </LinearLayout>

            <!-- Category Tabs (ViewPager2 Synchronized) -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutSelectionCategories"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/primary"
                app:tabIndicatorHeight="2.5dp"
                app:tabMode="scrollable"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="@color/primary"
                app:tabTextAppearance="@style/TextAppearance.Material3.LabelMedium"
                app:tabTextColor="@color/text_secondary" />

            <!-- Collapsible Search & Filter Controls (Matching School Schedule Search Bar Style) -->
            <LinearLayout
                android:id="@+id/cardSelectionSearchFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:visibility="visible">

                <!-- Row 1: Course Name/Code + Teacher Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSearchSelectionCourse"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1.15"
                        android:hint="课程名或代码"
                        app:boxBackgroundColor="#12FFFFFF"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/primary"
                        app:endIconMode="clear_text"
                        app:hintTextColor="@color/primary"
                        app:startIconDrawable="@drawable/ic_search"
                        app:startIconTint="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSearchSelectionCourse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingVertical="8dp"
                            android:textSize="12.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSearchSelectionTeacher"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:hint="授课教师"
                        app:boxBackgroundColor="#12FFFFFF"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/primary"
                        app:endIconMode="clear_text"
                        app:hintTextColor="@color/primary"
                        app:startIconDrawable="@drawable/ic_school"
                        app:startIconTint="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSearchSelectionTeacher"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingVertical="8dp"
                            android:textSize="12.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Row 2: "更多筛选 ▾" Button + "搜索" Action Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectionMoreFilters"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:paddingHorizontal="12dp"
                        android:text="更多筛选 ▾"
                        android:textColor="@color/primary"
                        android:textSize="12.5sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_tune"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/primary" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDoSelectionSearch"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:backgroundTint="@color/primary"
                            android:text="搜索选课"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_search"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            app:iconSize="16dp"
                            app:iconTint="#FFFFFF" />

                        <ProgressBar
                            android:id="@+id/progressBarSelectionSearch"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="12dp"
                            android:indeterminate="true"
                            android:indeterminateTint="#FFFFFF"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Quick Collapse Chevron inside the search bar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCollapseSelectionSearch"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="收起筛选"
                        app:icon="@drawable/ic_arrow_drop_down"
                        app:iconSize="22dp"
                        app:iconTint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="@color/border" />
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <!-- 3. Bottom Floating Pill: Selected Courses Summary (Clickable & Elevation-safe) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFloatingSelectedCourses"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/primary"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/surface"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:id="@+id/llFloatingSelectedContent"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_timetable"
                app:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/tvFloatingSelectedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="已选课程清单 (0门 · 0.0学分)"
                android:textColor="#FFFFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="›"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
