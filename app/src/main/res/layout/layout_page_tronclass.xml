<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutTronclass"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:visibility="gone">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshTronClass"
        android:enabled="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollTronClass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/llTronClassContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="48dp">

                <!-- Space for Floating Header -->
                <View
                    android:id="@+id/viewTronClassHeaderSpacing"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />

                <!-- User Profile & Action Hero Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTronClassHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/primary"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvTronClassUserName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="周智轩同学"
                                    android:textColor="@color/on_primary"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvTronClassUserNo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="学号: 2435055230"
                                    android:textColor="#E0FFFFFF"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTronClassSmartSign"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:backgroundTint="#FFFFFF"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="0dp"
                                android:text="⚡ 课堂签到"
                                android:textColor="@color/primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="18dp"
                                app:icon="@drawable/ic_location"
                                app:iconGravity="textStart"
                                app:iconPadding="4dp"
                                app:iconSize="16dp"
                                app:iconTint="@color/primary"
                                app:strokeColor="#FFFFFF"
                                app:strokeWidth="1dp" />

                        </LinearLayout>

                        <!-- Login Prompt Button (visible if not logged in) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTronClassLoginPrompt"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="#FFFFFF"
                            android:text="统一身份认证授权登录"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:cornerRadius="12dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Active Rollcall Ongoing Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTronClassActiveRollcall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/grade_green_bg"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#86EFAC"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚨"
                            android:textSize="22sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="教师发起课堂签到！"
                                android:textColor="@color/grade_green_text"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTronClassActiveRollcallInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="课程: 正在签到中..."
                                android:textColor="@color/grade_green_text"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTronClassQuickSign"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:backgroundTint="@color/grade_green_text"
                            android:text="立即签到"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            app:cornerRadius="10dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Two-Pane Container: Pad landscape sets orientation to HORIZONTAL -->
                <LinearLayout
                    android:id="@+id/llTronClassBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Left Pane: 待办作业与测验 -->
                    <LinearLayout
                        android:id="@+id/llTronClassLeftPane"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Section 1 Header: 待办作业与测验 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="待办作业与测验"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTronClassTodoBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_rounded"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="0 项待办"
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Todos RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTronClassTodos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/item_tronclass_todo" />

                        <!-- Empty Todos View -->
                        <TextView
                            android:id="@+id/tvTronClassEmptyTodos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginVertical="16dp"
                            android:gravity="center"
                            android:padding="20dp"
                            android:text="🎉 太棒了，当前暂无任何待交作业！"
                            android:textColor="@color/text_tertiary"
                            android:textSize="14sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Right Pane: 我的在读课程 -->
                    <LinearLayout
                        android:id="@+id/llTronClassRightPane"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Section 2 Header: 我的在读课程 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvTronClassCourseSectionTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="本学期在读课程"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTronClassCourseBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_rounded"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="0 门"
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Course Search Box (Course Name, Course Code, Teacher) -->
                        <LinearLayout
                            android:id="@+id/llTronClassCourseSearch"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_badge_rounded"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_search"
                                app:tint="@color/text_secondary" />

                            <EditText
                                android:id="@+id/etTronClassCourseSearch"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="搜索课程名、课程代码、教师姓名..."
                                android:imeOptions="actionSearch"
                                android:inputType="text"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_tertiary"
                                android:textSize="12.5sp" />

                            <ImageView
                                android:id="@+id/btnTronClassCourseSearchClear"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="3dp"
                                android:src="@drawable/ic_close"
                                android:visibility="gone"
                                app:tint="@color/text_tertiary" />

                        </LinearLayout>

                        <!-- 学期分类过滤 Chip 栏 (根据班级号中 (xxxx-xxxx-x) 动态提取) -->
                        <HorizontalScrollView
                            android:id="@+id/hsvTronClassSemesters"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginBottom="8dp"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipGroupTronClassSemesters"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:singleSelection="true"
                                app:selectionRequired="true" />

                        </HorizontalScrollView>

                        <!-- Courses RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTronClassCourses"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/item_tronclass_course" />

                        <!-- Empty Courses View -->
                        <TextView
                            android:id="@+id/tvTronClassEmptyCourses"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginVertical="16dp"
                            android:gravity="center"
                            android:padding="20dp"
                            android:text="暂无课程数据，点击右上角刷新获取"
                            android:textColor="@color/text_tertiary"
                            android:textSize="14sp"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Floating Top Header Bar with BlurView -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurViewTronClass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top">

        <LinearLayout
            android:id="@+id/llTronClassHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_top_bar"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Open Drawer Button (Sidebar Mode) -->
            <ImageView
                android:id="@+id/btnOpenDrawerTronClass"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="打开侧栏"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvTronClassPageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="一网畅学 · 移动教学"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTronClassCacheManager"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:padding="0dp"
                android:contentDescription="缓存管理"
                app:icon="@drawable/ic_storage"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTronClassDownloads"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:padding="0dp"
                android:contentDescription="离线课件"
                app:icon="@drawable/ic_download"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshTronClass"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:padding="0dp"
                android:contentDescription="刷新"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/primary" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:background="@color/border" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <!-- Secondary Page Host Container for TronClass -->
    <FrameLayout
        android:id="@+id/flTronClassSecondaryContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>
