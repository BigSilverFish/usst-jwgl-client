<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/svScheduleContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24px"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/flScheduleContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/llContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Sidebar (Nodes 1..13) -->
                <LinearLayout
                    android:id="@+id/llSidebarNodes"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Nodes injected dynamically -->
                </LinearLayout>

                <!-- 7 Day Columns -->
                <LinearLayout
                    android:id="@+id/llWeekColumnsContainer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <!-- 7 FrameLayout columns injected dynamically -->
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="GitHub@BigSilverFish"
            android:textColor="#C0C0C0"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
