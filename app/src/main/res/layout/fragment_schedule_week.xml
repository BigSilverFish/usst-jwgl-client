<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header Days Bar -->
    <LinearLayout
        android:id="@+id/llHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface">

        <!-- Month Box (Matches Sidebar Width) -->
        <TextView
            android:id="@+id/tvMonthHeader"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="1dp"
            android:text="9\n月" />

        <!-- 7 Days Header Containers (Mon - Sun) -->
        <LinearLayout
            android:id="@+id/llDayHeaderContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Days 1 to 7 injected dynamically -->
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Scrollable Timetable Grid with draggable bottom space -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/svScheduleContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Sidebar (Nodes 1..13) -->
                <LinearLayout
                    android:id="@+id/llSidebarNodes"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Nodes injected dynamically -->
                </LinearLayout>

                <!-- 7 Day Columns -->
                <LinearLayout
                    android:id="@+id/llWeekColumnsContainer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <!-- 7 FrameLayout columns injected dynamically -->
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="24dp"
                android:text="GitHub@BigSilverFish"
                android:textColor="#C0C0C0"
                android:textSize="11sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
