<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false"
        android:background="@color/background">

    <LinearLayout
        android:id="@+id/llRootHorizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Permanent Side Navigation Rail/Sidebar for Pad Landscape -->
        <FrameLayout
            android:id="@+id/permanentSidebarContainer"
            android:layout_width="265dp"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:visibility="gone" />

        <View
            android:id="@+id/viewPermanentSidebarDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/border"
            android:visibility="gone" />

    <FrameLayout
        android:id="@+id/mainContentFrame"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- 1. Profile Section -->
        <ViewStub
            android:id="@+id/stubProfile"
            android:inflatedId="@+id/layoutProfile"
            android:layout="@layout/layout_page_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 2. Timetable Section -->
        <FrameLayout
            android:id="@+id/layoutTimetable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:visibility="visible">

            <!-- WakeUP Multi-Week ViewPager2 (Full Screen behind floating top bar) -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpSchedule"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/timetableProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="32dp"
                android:visibility="gone" />

            <!-- Unified Floating Frosted Glass Top Bar (Controls + Weekdays) -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurViewTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top">

                <LinearLayout
                    android:id="@+id/headerTimetableContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_top_bar">

                    <!-- Controls Header Bar -->
                    <LinearLayout
                        android:id="@+id/headerTimetable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="6dp">

                        <!-- Row 1: Semester Selector + Week Badge + Actions -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Open Drawer Button -->
                            <ImageView
                                android:id="@+id/btnOpenDrawerTimetable"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:padding="7dp"
                                android:layout_marginEnd="6dp"
                                android:src="@drawable/ic_menu"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true"
                                app:tint="@color/text_primary"
                                android:contentDescription="打开侧栏" />

                            <!-- Clickable Semester Selector -->
                            <LinearLayout
                                android:id="@+id/btnSelectSemester"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingVertical="4dp">

                                <TextView
                                    android:id="@+id/tvTimetableSemester"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2026-2027学年 第1学期"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_arrow_drop_down"
                                    app:tint="@color/text_secondary" />
                            </LinearLayout>

                            <!-- 1. Refresh Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRefreshTimetable"
                                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="6dp"
                                android:padding="0dp"
                                android:contentDescription="刷新课表"
                                app:icon="@drawable/ic_refresh"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="20dp"
                                app:iconTint="@color/text_secondary" />


                            <!-- 3. Font Size Setting Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFontSize"
                                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="6dp"
                                android:padding="0dp"
                                android:contentDescription="字号"
                                app:icon="@drawable/ic_format_size"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="20dp"
                                app:iconTint="@color/text_secondary" />

                            <!-- 4. Add Course Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddCourse"
                                style="@style/Widget.Material3.Button.IconButton.Filled"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="6dp"
                                android:padding="0dp"
                                android:contentDescription="添加课程"
                                app:icon="@drawable/ic_add"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="20dp"
                                app:iconTint="@color/on_primary" />
                        </LinearLayout>

                        <!-- Row 2: Sync status & Filter toggle -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvTimetableSyncTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="本地缓存 · 刚刚更新"
                                android:textColor="@color/text_tertiary"
                                android:textSize="11sp" />

                            <!-- Clickable Week Selector Capsule Button (Adjusted to Row 2, 24dp height) -->
                            <LinearLayout
                                android:id="@+id/btnSelectWeek"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/badge_bg_clickable"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">

                                <TextView
                                    android:id="@+id/tvCurrentWeekIndicator"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="第 1 周 (本周)"
                                    android:textColor="@color/primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_marginStart="2dp"
                                    android:src="@drawable/ic_arrow_drop_down"
                                    app:tint="@color/primary" />
                            </LinearLayout>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFilterOnlyCurrentWeek"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:checkable="true"
                                android:checked="false"
                                android:text="仅本周课程"
                                android:textSize="11sp"
                                app:chipCornerRadius="12dp"
                                app:chipMinHeight="24dp"
                                app:chipStartPadding="6dp"
                                app:chipEndPadding="6dp"
                                app:chipIconSize="12dp"
                                app:ensureMinTouchTargetSize="false" />
                        </LinearLayout>

                        <!-- Row 3: Historical Semester Notification Banner -->
                        <LinearLayout
                            android:id="@+id/layoutHistoricalBanner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/badge_bg"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvHistoricalBannerText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="历史学期 (只读课表)"
                                android:textColor="@color/primary"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSetActiveSemester"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:text="设为当前课表"
                                android:textColor="@color/primary"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Integrated Weekday Date Header Bar -->
                    <LinearLayout
                        android:id="@+id/llHeaderBar"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Month Box (Matches Sidebar Width) -->
                        <TextView
                            android:id="@+id/tvMonthHeader"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="1dp"
                            android:text="9\n月" />

                        <!-- 7 Days Header Containers (Mon - Sun) -->
                        <LinearLayout
                            android:id="@+id/llDayHeaderContainer"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <!-- Bottom Border Line for Timetable Top Bar -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.8dp"
                        android:background="@color/border" />

                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

        </FrameLayout>

        <!-- 3. Grades Independent Container -->
        <FrameLayout
            android:id="@+id/containerGrades"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:visibility="gone" />

        <!-- 4. School Course Search Independent Container -->
        <FrameLayout
            android:id="@+id/containerCourseSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 5. Free Classroom Independent Container -->
        <FrameLayout
            android:id="@+id/containerFreeClassroom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 6. Exam Query Independent Container -->
        <FrameLayout
            android:id="@+id/containerExamQuery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 7. Grade Reports & Proofs Independent Container -->
        <FrameLayout
            android:id="@+id/containerGradeReports"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 8. More Features Hub Page (For Phone Bottom Bar Mode) -->
        <ViewStub
            android:id="@+id/stubMoreFeatures"
            android:inflatedId="@+id/layoutMoreFeatures"
            android:layout="@layout/layout_page_more_features"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 9. TronClass Native Embedded Fragment Container -->
        <FrameLayout
            android:id="@+id/containerTronclass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:visibility="gone" />

    </FrameLayout>
    </LinearLayout>

    <!-- Custom 4-Tab Frosted Glass Bottom Navigation Bar (For Phone Bottom Bar Mode) -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurViewBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/llBottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_bottom_bar">

            <!-- Top Border Line for Bottom Nav Bar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="@color/border" />

            <!-- 4 Bottom Navigation Tabs: 课程表 / 成绩查询 / 更多功能 / 个人设置 -->
            <LinearLayout
                android:id="@+id/llBottomNavTabs"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <!-- Tab 1: 课程表 -->
                <LinearLayout
                    android:id="@+id/tabBottomTimetable"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/flBottomPillTimetable"
                        android:layout_width="56dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_bottom_nav_pill">

                        <ImageView
                            android:id="@+id/ivBottomTimetable"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_nav_timetable"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvBottomTimetable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:text="课程表"
                        android:textColor="@color/primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tab 2: 成绩查询 -->
                <LinearLayout
                    android:id="@+id/tabBottomGrades"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/flBottomPillGrades"
                        android:layout_width="56dp"
                        android:layout_height="28dp">

                        <ImageView
                            android:id="@+id/ivBottomGrades"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_nav_grades"
                            app:tint="@color/text_secondary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvBottomGrades"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:text="成绩查询"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Tab 3: 一网畅学 -->
                <LinearLayout
                    android:id="@+id/tabBottomTronClass"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/flBottomPillTronClass"
                        android:layout_width="56dp"
                        android:layout_height="28dp">

                        <ImageView
                            android:id="@+id/ivBottomTronClass"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_school"
                            app:tint="@color/text_secondary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvBottomTronClass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:text="课程门户"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Tab 4: 更多功能 -->
                <LinearLayout
                    android:id="@+id/tabBottomMore"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/flBottomPillMore"
                        android:layout_width="56dp"
                        android:layout_height="28dp">

                        <ImageView
                            android:id="@+id/ivBottomMore"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_more_features"
                            app:tint="@color/text_secondary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvBottomMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:text="更多功能"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Tab 4: 个人设置 -->
                <LinearLayout
                    android:id="@+id/tabBottomProfile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/flBottomPillProfile"
                        android:layout_width="56dp"
                        android:layout_height="28dp">

                        <ImageView
                            android:id="@+id/ivBottomProfile"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_nav_profile"
                            app:tint="@color/text_secondary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvBottomProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:text="个人设置"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Navigation Bar / Full Screen Gesture Inset Spacer -->
            <View
                android:id="@+id/viewNavBarSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Side Navigation Drawer -->
    <include
        android:id="@+id/layoutDrawer"
        layout="@layout/layout_main_drawer"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
