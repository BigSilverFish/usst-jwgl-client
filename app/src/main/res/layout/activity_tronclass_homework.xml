<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/llHomeworkRootContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp">

                <!-- Space for Floating Header -->
                <View
                    android:id="@+id/viewHeaderSpacing"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />

                <!-- Split layout container (Vertical on Phone, Horizontal on Pad) -->
                <LinearLayout
                    android:id="@+id/llHomeworkColumns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <!-- Left Column: Overview, Feedback & Requirements -->
                    <LinearLayout
                        android:id="@+id/llHomeworkColLeft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 1. Hero Card: Title, Status, Deadline -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardHero"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/border"
                            app:strokeWidth="0.8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvCourseName"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textColor="@color/primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        tools:text="数字图像处理A" />

                                    <TextView
                                        android:id="@+id/tvStatusBadge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_badge_rounded"
                                        android:backgroundTint="@color/primary_container"
                                        android:paddingHorizontal="10dp"
                                        android:paddingVertical="4dp"
                                        android:textColor="@color/primary"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        tools:text="未提交" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvHomeworkTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textColor="@color/text_primary"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="某个项目的WBS，个人提交" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="0.8dp"
                                    android:layout_marginVertical="12dp"
                                    android:background="@color/border" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvDeadline"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="13sp"
                                        tools:text="截止时间：2026-11-13 15:55 (剩 24 天)" />

                                    <TextView
                                        android:id="@+id/tvScoreWeight"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="13sp"
                                        tools:text="分值比例：5.0% · 最新得分计入总评" />

                                </LinearLayout>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- 2. Teacher Feedback & Score Card (Visible when graded / comments exist) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardFeedback"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/border"
                            app:strokeWidth="0.8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="🎯 教师批改与成绩反馈"
                                        android:textColor="#2E7D32"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvTeacherScore"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_badge_rounded"
                                        android:backgroundTint="@color/grade_green_bg"
                                        android:paddingHorizontal="10dp"
                                        android:paddingVertical="4dp"
                                        android:textColor="@color/grade_green_text"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        tools:text="90 分" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvTeacherComment"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    tools:text="教师评语：图文并茂，结构层次清晰，很好地完成了分解任务。" />

                                <LinearLayout
                                    android:id="@+id/llCorrectionAttachments"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="vertical" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- 3. Requirement Card (Description + Teacher Attachments) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardRequirement"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/border"
                            app:strokeWidth="0.8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📝 作业题目与要求说明"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvRequirementDesc"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:lineSpacingExtra="4dp"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14.5sp"
                                    tools:text="可采用清单式，也可采用图表式，建议3-4层，标注WBS每个工作包的编码" />

                                <!-- Embedded Rich Images Container -->
                                <LinearLayout
                                    android:id="@+id/llRequirementImages"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="vertical"
                                    android:visibility="gone" />

                                <!-- Teacher Attachments Container -->
                                <TextView
                                    android:id="@+id/tvTeacherAttachmentsHeader"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:text="📎 教师随堂附件"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/llTeacherAttachments"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="vertical" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- Right Column: Submission & Actions -->
                    <LinearLayout
                        android:id="@+id/llHomeworkColRight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 4. Submission Record Card (Submitted files & comments) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardSubmissionRecord"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/border"
                            app:strokeWidth="0.8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="📤 我的提交记录"
                                        android:textColor="@color/text_primary"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvSubmittedAt"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="12sp"
                                        tools:text="2026-10-19 10:56" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvStudentComment"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13.5sp"
                                    android:visibility="gone"
                                    tools:text="提交附言：这是我完成的实验代码和报告。" />

                                <LinearLayout
                                    android:id="@+id/llStudentUploads"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="vertical" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnToggleResubmit"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="12dp"
                                    android:text="重新提交 / 补充附件"
                                    android:textSize="13sp"
                                    app:cornerRadius="12dp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- 5. Submit Action Card (Form to submit / upload) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardSubmitAction"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="32dp"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/border"
                            app:strokeWidth="0.8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/tvSubmitHeader"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📥 提交作业与附件"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilSubmissionComment"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:hint="作业附言说明（可选）">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etSubmissionComment"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="top"
                                        android:lines="3"
                                        android:textColor="@color/text_primary"
                                        android:textSize="14sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <!-- Selected Pending Files -->
                                <LinearLayout
                                    android:id="@+id/llPendingFiles"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="vertical" />

                                <!-- Upload Progress Bar -->
                                <LinearLayout
                                    android:id="@+id/llUploadProgress"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/tvUploadStatusText"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="正在上传附件..."
                                            android:textColor="@color/text_secondary"
                                            android:textSize="12sp" />

                                        <TextView
                                            android:id="@+id/tvUploadProgressPercent"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="@color/primary"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            tools:text="45%" />

                                    </LinearLayout>

                                    <ProgressBar
                                        android:id="@+id/progressBarUpload"
                                        style="?android:attr/progressBarStyleHorizontal"
                                        android:layout_width="match_parent"
                                        android:layout_height="6dp"
                                        android:layout_marginTop="4dp"
                                        android:max="100" />

                                </LinearLayout>

                                <!-- Action Buttons -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:orientation="horizontal">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnAddAttachment"
                                        style="@style/Widget.Material3.Button.OutlinedButton"
                                        android:layout_width="0dp"
                                        android:layout_height="48dp"
                                        android:layout_marginEnd="8dp"
                                        android:layout_weight="1"
                                        android:text="选择手机文件"
                                        android:textSize="13.5sp"
                                        app:cornerRadius="12dp"
                                        app:icon="@drawable/ic_upload" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnSubmitHomework"
                                        style="@style/Widget.Material3.Button"
                                        android:layout_width="0dp"
                                        android:layout_height="48dp"
                                        android:layout_marginStart="8dp"
                                        android:layout_weight="1"
                                        android:text="确认提交"
                                        android:textSize="13.5sp"
                                        app:cornerRadius="12dp" />

                                </LinearLayout>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Frosted Glass Floating Top Bar -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurViewHomework"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top">

        <LinearLayout
            android:id="@+id/llHeaderBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_top_bar"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llHeaderBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="作业详情"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeaderSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp"
                        tools:text="数字图像处理A" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefresh"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:padding="0dp"
                    android:contentDescription="刷新"
                    app:icon="@drawable/ic_refresh"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/primary" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="@color/border" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

</FrameLayout>
