<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- 顶部拖动手柄 -->
    <ImageView
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/drag_handle" />

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/primary_container">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield"
                app:tint="@color/primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="作者声明与免责隐私协议"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="上海理工大学第三方校园助手规范与承诺"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseDisclaimer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <!-- 中间条款滑动视图（限制最大展示高度并保证流畅阅读） -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <!-- 1. 项目定位 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一、项目背景与非官方性质"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="本应用为上海理工大学在校学子出于技术学习交流、开源实践及提升校园移动端使用体验而独立开发的第三方工具，非上海理工大学官方或商业机构出品。本应用与学校教务处、信息化办公室及相关商业合作平台无任何隶属或商业利益关联。"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <!-- 2. 隐私与安全承诺 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="二、隐私保护与数据安全承诺"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="1. 客户端点对点直连：本应用不设任何云端数据中转服务器。所有课表排布、成绩明细、作业进度及签到点名交互，均由您的本地设备与学校官方服务器（统一身份认证 CAS、教务系统、畅课、超星学习通等）直接建立安全加密传输。\n\n2. 本地沙盒强加密：您的统一身份认证学号、密码、登录令牌等鉴权数据，均严格存储在手机本地硬件级加密沙盒（Android Keystore / EncryptedSharedPreferences）中。应用绝对不会上传、收集、中转或泄露任何用户的账号隐私与敏感数据。"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <!-- 3. 免责条款与使用规范 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="三、免责声明与服务可用性"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="1. 官方数据具有最终效力：本软件呈现的数据均依赖于学校公开接口与网页解析。若因校园网维护、接口结构调整、网络抖动等原因导致数据延迟或偏差，请以学校官方教务系统及教学平台记录为准。\n\n2. 辅助工具使用规范：课堂点名提醒、后台监听与辅助签到功能仅作为防止同学漏签的便民提醒工具。请自觉遵守校纪校规，合理使用本软件，严禁用于任何破坏正常教学秩序的非正当行为。因基准漂移、网络拥堵等不可抗力导致的签到异常，开发者不承担连带责任。"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <!-- 4. 开源共建与联系作者 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="四、开源共建与联系作者"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="本应用代码公开透明，面向全校师生免费提供。若您在使用过程中发现任何问题、有宝贵的改进建议，或有相关诉求需要反馈，欢迎通过以下方式与作者取得联系："
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <!-- 邮箱联系卡片（支持点击直接复制或调起邮件） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmailContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface_variant"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/primary_container">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mail"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEmailAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="nicolaszhaoquad@gmail.com"
                            android:textColor="@color/primary"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="点击复制邮箱或调起邮件客户端"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/surface"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="联系作者"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <!-- 底部操作按钮：首次必须选择协议（双按钮） -->
    <LinearLayout
        android:id="@+id/layoutFirstLaunchButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisagree"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="不同意并退出"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgree"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="同意并继续"
            android:textColor="@color/on_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- 底部操作按钮：普通查看（单按钮） -->
    <LinearLayout
        android:id="@+id/layoutNormalButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseNormal"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="@color/primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="我已了解"
            android:textColor="@color/on_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
