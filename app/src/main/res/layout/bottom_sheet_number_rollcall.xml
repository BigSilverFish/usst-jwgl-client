<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- 顶部拖动条 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/drag_handle" />

    <!-- 标题与课程名称 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="数字口令签到"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCourseName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="课堂点名连接中..."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 4位 PIN 码数字显示方格 -->
    <LinearLayout
        android:id="@+id/layoutPinBoxes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 第 1 位 -->
        <FrameLayout
            android:id="@+id/boxPin1"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_pin_box_active">

            <TextView
                android:id="@+id/tvPin1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 第 2 位 -->
        <FrameLayout
            android:id="@+id/boxPin2"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pin_box">

            <TextView
                android:id="@+id/tvPin2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 第 3 位 -->
        <FrameLayout
            android:id="@+id/boxPin3"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pin_box">

            <TextView
                android:id="@+id/tvPin3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 第 4 位 -->
        <FrameLayout
            android:id="@+id/boxPin4"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pin_box">

            <TextView
                android:id="@+id/tvPin4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

    </LinearLayout>

    <!-- 提示与状态区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/progressSubmitting"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatusTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="输入满 4 位后自动提交签到"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 多账号同步签到勾选 -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbSignAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:checked="true"
        android:text="同时为全部已保存账号签到 (独立设备码)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 锁屏风格固定九宫格数字键盘区域 -->
    <LinearLayout
        android:id="@+id/layoutKeypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <!-- 第 1 排: 1, 2, 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/key1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 第 2 排: 4, 5, 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/key4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key5"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key6"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 第 3 排: 7, 8, 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/key7"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="7"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key8"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="8"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key9"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="9"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 第 4 排: 清空 (C), 0, 退格 (⌫) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/keyClear"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="清空"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key0"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/keyDelete"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_backspace"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
