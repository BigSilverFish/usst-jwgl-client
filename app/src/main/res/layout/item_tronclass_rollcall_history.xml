<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0.5dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="0.8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- 左侧签到图标容器 -->
        <FrameLayout
            android:id="@+id/layoutIconBg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="#EFF6FF">

            <ImageView
                android:id="@+id/ivRollcallTypeIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rollcall_history"
                app:tint="@color/primary" />
        </FrameLayout>

        <!-- 中间信息栏 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRollcallTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold"
                tools:text="第 1 次课堂签到" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRollcallTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="#F1F5F9"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1.5dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="10.5sp"
                    tools:text="雷达定位" />

                <TextView
                    android:id="@+id/tvRollcallTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11.5sp"
                    tools:text="2026-03-24 10:15" />

            </LinearLayout>

        </LinearLayout>

        <!-- 右侧签到状态 Badge 胶囊 -->
        <TextView
            android:id="@+id/tvRollcallStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="#E8F5E9"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="已出勤"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="已出勤" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
