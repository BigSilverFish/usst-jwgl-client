<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Course Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <View
                android:id="@+id/viewManageColor"
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="8dp"
                android:background="@color/primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvManageCourseName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="课程名称"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Badges Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvManageCourseCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_bg"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="12004546"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tvManageExamType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_bg"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="考试"
                        android:textColor="@color/primary"
                        android:textSize="10.5sp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tvManageCredit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_bg"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="3.0学分"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvManageTeacher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="任课教师: 张老师"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Delete Entire Course Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageDeleteEntireCourse"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="0dp"
                android:contentDescription="删除课程"
                app:icon="@drawable/ic_logout"
                app:iconSize="18dp"
                app:iconTint="@color/grade_red_text" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/border" />

        <!-- Slots Container -->
        <LinearLayout
            android:id="@+id/layoutManageSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
