<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutGrades"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshGrades"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollGrades"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24px">

            <LinearLayout
                android:id="@+id/llGradesContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Space for floating headerGrades -->
                <View
                    android:id="@+id/viewGradesHeaderSpacing"
                    android:layout_width="match_parent"
                    android:layout_height="115dp" />

                <LinearLayout
                    android:id="@+id/llGradesBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/llGradesLeftPane"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardStatisticsOverview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/hero_card_bg"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="18dp"
                                android:paddingHorizontal="12dp">

                                <!-- Col 1: Credits -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvCreditsTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="累计修读学分"
                                        android:textColor="@color/hero_card_title"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvCumulativeCredits"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="--"
                                        android:textColor="@color/hero_card_val"
                                        android:textSize="20sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="center_vertical"
                                    android:background="@color/hero_card_divider" />

                                <!-- Col 2: Weighted Average (100-pt) -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvAvgScoreTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="加权平均分"
                                        android:textColor="@color/hero_card_title"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvCumulativeAvgScore"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="--"
                                        android:textColor="@color/hero_card_val"
                                        android:textSize="20sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="center_vertical"
                                    android:background="@color/hero_card_divider" />

                                <!-- Col 3: GPA -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvGpaTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="平均学分绩点"
                                        android:textColor="@color/hero_card_title"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvCumulativeGpa"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="--"
                                        android:textColor="@color/hero_card_val"
                                        android:textSize="20sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Tablet Landscape Master Card: Semester Breakdown & Quick Switcher -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardGradesSemesterMaster"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/border"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginBottom="8dp"
                                    android:text="历年学期绩点总览 · 点击筛选"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12.5sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:id="@+id/llGradesSemesterMasterList"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llGradesRightPane"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ProgressBar
                            android:id="@+id/gradesProgressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="24dp"
                            android:visibility="gone" />

                        <!-- Courses RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvGrades"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/tvGradesWatermark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="-9dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="GitHub@BigSilverFish"
                            android:textColor="#C0C0C0"
                            android:textSize="11sp" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Floating Controls Header Bar with BlurView and Progressive Fade -->
    <LinearLayout
        android:id="@+id/llGradesHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top">

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurViewGradesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/headerGradesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_top_bar">

                <!-- Controls Header Bar (Matches Timetable Top Bar Style) -->
                <LinearLayout
                    android:id="@+id/headerGrades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp">

                    <!-- Row 1: Semester Selector + Scope Badge + Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Open Drawer Button -->
                        <ImageView
                            android:id="@+id/btnOpenDrawerGrades"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:padding="7dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_menu"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            app:tint="@color/text_primary"
                            android:contentDescription="打开侧栏" />

                        <!-- Clickable Semester Selector -->
                        <LinearLayout
                            android:id="@+id/btnSelectGradeSemester"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingVertical="4dp">

                            <TextView
                                android:id="@+id/tvGradeSemester"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="全部学期"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:singleLine="true"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/ic_arrow_drop_down"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <!-- Query Ranking Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQueryRanking"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:padding="0dp"
                            android:contentDescription="查询排名"
                            app:icon="@drawable/ic_ranking"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="20dp"
                            app:iconTint="@color/primary" />

                        <!-- Download Reports & Certificates Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDownloadGradeReports"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:padding="0dp"
                            android:contentDescription="下载证明与成绩单"
                            app:icon="@drawable/ic_download"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="20dp"
                            app:iconTint="@color/primary" />

                        <!-- Refresh Grades Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRefreshGrades"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:padding="0dp"
                            android:contentDescription="刷新成绩"
                            app:icon="@drawable/ic_refresh"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="20dp"
                            app:iconTint="@color/primary" />
                    </LinearLayout>

                    <!-- Row 2: Sync status & Course count summary -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvGradesSyncTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="本地缓存 · 刚刚更新"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvGradesCountSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="共 -- 门课程"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bottom Border Line for Grades Top Bar (Edge-to-Edge at the very bottom) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.8dp"
                    android:background="@color/border" />
            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>

    </LinearLayout>

</FrameLayout>
