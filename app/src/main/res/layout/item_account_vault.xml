<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAccount"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- 头像 / 姓名缩写徽章 -->
        <FrameLayout
            android:id="@+id/layoutAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/primary_container">

            <TextView
                android:id="@+id/tvAvatarText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="学"
                android:textColor="@color/primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 详细信息列 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 姓名 + 学号 + 活跃状态标签 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="姓名"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStudentId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="(210000000)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- 使用中 Badge -->
                <TextView
                    android:id="@+id/badgeActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_bg"
                    android:backgroundTint="@color/grade_green_bg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="当前使用"
                    android:textColor="@color/grade_green_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 学院专业信息 -->
            <TextView
                android:id="@+id/tvCollegeMajor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="上海理工大学"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <!-- 活跃与免密状态 -->
            <TextView
                android:id="@+id/tvAccountStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="支持免密瞬切"
                android:textColor="@color/text_tertiary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 右侧操作区：如果是当前账号显示勾选，否则显示切换/删除 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivActiveCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"
                app:tint="@color/primary" />

            <ImageView
                android:id="@+id/btnDeleteAccount"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_tertiary" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
