<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <ImageView
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/drag_handle" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全校空教室自习查询"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="实时对比全校各教学楼排课数据 · 智能计算空闲自习教室"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseSheet"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="关闭"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/text_secondary" />
    </LinearLayout>

    <!-- Filter Spinners Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <!-- Building Spinner -->
        <Spinner
            android:id="@+id/spinnerBuilding"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.2"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="8dp" />

        <!-- Day Spinner -->
        <Spinner
            android:id="@+id/spinnerDay"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="0.9"
            android:layout_marginStart="6dp"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="8dp" />

        <!-- Section Range Spinner -->
        <Spinner
            android:id="@+id/spinnerSection"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.1"
            android:layout_marginStart="6dp"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- Summary & Filter Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvSummaryCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="正在计算空闲教室..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cbOnlyFree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="仅看空闲"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progressBarFree"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Results List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvClassroomList"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <!-- Empty View -->
    <LinearLayout
        android:id="@+id/layoutEmptyFree"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="该时段暂无教室空闲"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="可尝试切换至其他教学楼或节次"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
