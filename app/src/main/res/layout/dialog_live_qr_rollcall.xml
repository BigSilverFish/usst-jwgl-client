<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 顶部拖拽手柄 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/surface_variant"
            android:padding="8dp"
            android:src="@drawable/ic_camera"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="课堂大屏 · 实时抓帧扫码"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLiveQrCourseInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="当前课程 · 正在连接推流机位..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 实时出勤人数徽章 -->
            <TextView
                android:id="@+id/tvLiveAttendanceStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/surface_variant"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="👥 正在查询出勤人数..."
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvLiveQrCameraBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/surface_variant"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="机位: --"
            android:textColor="@color/primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 核心区域：大屏画面实时渲染卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp">

            <!-- 渲染抓取的最新 Bitmap 图像 -->
            <ImageView
                android:id="@+id/ivLiveFramePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0A0A0A"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_camera" />

            <!-- 扫描框或未连接占位蒙层 -->
            <LinearLayout
                android:id="@+id/layoutFrameLoading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#99000000"
                android:gravity="center"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/pbFrameLoading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:id="@+id/tvFrameLoadingTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="正在同步教室大屏实时画面..."
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 画面上角实时刷新指示点 -->
            <TextView
                android:id="@+id/tvLiveIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#80000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🔴 LIVE 追帧中"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 追帧状态与识别反馈卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border"
        app:strokeWidth="0.8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/pbSearchingQr"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:id="@+id/tvLiveFrameStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="正在每隔 2.5 秒采样分析大屏关键帧..."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLiveTimerCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第 0 帧 (0s)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvLiveDetailLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="提示: 老师切到签到二维码时将毫秒级自动解析并提交，请保持弹窗开启"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFallbackCameraScan"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="相机扫码"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            android:textColor="@color/text_primary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseLiveQr"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_variant"
            android:text="停止追帧"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>